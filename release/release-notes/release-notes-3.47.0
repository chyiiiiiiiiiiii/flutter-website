apsed" data-toggle="collapse" data-target="#sidenav-40-9" role="button" aria-expanded="false" aria-controls="sidenav-40-9"><div><span>參考</span></div><span class="material-symbols expander" aria-hidden="true" translate="no">expand_more</span></button><ul id="sidenav-40-9" class="nav collapse"><li class="nav-item"><a class="nav-link" href="/dash"><div><span>Dash 是誰？</span></div></a></li><li class="nav-item"><a class="nav-link" href="/reference/widgets"><div><span>元件索引</span></div></a></li><li class="nav-item"><a class="nav-link" href="/reference/create-new-app"><div><span>建立新應用程式</span></div></a></li><li class="nav-item"><a class="nav-link" href="/reference/flutter-cli"><div><span>flutter CLI</span></div></a></li><li class="nav-item"><a class="nav-link" rel="noopener" href="https://api.flutter.dev" target="_blank"><div><span>API 文件</span><span class="material-symbols" aria-hidden="true" translate="no">open_in_new</span></div></a></li><li class="nav-item"><a class="nav-link" rel="noopener" href="https://pub.dev" target="_blank"><div><span>pub.dev</span><span class="material-symbols" aria-hidden="true" translate="no">open_in_new</span></div></a></li></ul></li></ul>
