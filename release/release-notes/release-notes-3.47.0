                <h1 id="document-title">Flutter 3.47.0 發行說明</h1>
                <p class="page-description">Flutter 3.47.0 的發行說明。</p>
                <!--@site_shared:page_header_options data={"title":"Flutter 3.47.0 發行說明","markdownUrl":"/release/release-notes/release-notes-3.47.0.md","sourceUrl":"https://github.com/flutter/website/blob/main/sites/docs/src/content/release/release-notes/release-notes-3.47.0.md","issueUrl":"https://github.com/flutter/website/issues/new?template=1_page_issue.yml&amp;page-url=https://docs.flutter.tw/release/release-notes/release-notes-3.47.0&amp;page-source=https://github.com/flutter/website/blob/main/sites/docs/src/content/release/release-notes/release-notes-3.47.0.md"}-->
