                <h1 id="document-title">Flutter 1.9.1 發行說明</h1>
                <p class="page-description">Flutter 1.9.1 的發行說明。</p>
                <!--@page_header_options data={"title":"Flutter 1.9.1 發行說明","sourceUrl":"https://github.com/flutter/website/blob/main/sites/docs/src/content/release/release-notes/release-notes-1.9.1.md","issueUrl":"https://github.com/flutter/website/issues/new?template=1_page_issue.yml&amp;page-url=https://docs.flutter.tw/release/release-notes/release-notes-1.9.1&amp;page-source=https://github.com/flutter/website/blob/main/sites/docs/src/content/release/release-notes/release-notes-1.9.1.md"}-->
