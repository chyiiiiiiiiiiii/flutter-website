                      <a property="item" typeof="WebPage" href="/release/release-notes"><span property="name">發行說明</span></a><meta property="position" content="1"/><span class="material-symbols" aria-hidden="true" translate="no">chevron_right</span>
                    </li>
                    <li class="breadcrumb-item active" property="itemListElement" typeof="ListItem" aria-current="page">
                      <a property="item" typeof="WebPage" href="/release/release-notes/release-notes-1.12.13"><span property="name">1.12.13 發行說明</span></a><meta property="position" content="2"/>
                    </li>
